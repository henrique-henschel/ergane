classDiagram
direction TB

%% UC09–UC13; UC09 exige um ou mais itens, apesar da cardinalidade geral 0..* para conversão descritiva.

class Conta {
        +id: UUID
        +nome: String
        +fusoHorario: ZoneId
        +ativa: Boolean
        +criadaEm: Instant
    }

class Produto {
        +id: UUID
        +contaId: UUID
        +categoriaId: UUID?
        +nome: String
        +diferenciador: String?
        +descricao: String?
        +precoVenda: Dinheiro
        +custoUnitario: Dinheiro?
        +validade: LocalDate?
        +arquivadoEm: Instant?
        +versao: Long
        +criadoPorId: UUID
        +criadoEm: Instant
    }

class Venda {
        +id: UUID
        +contaId: UUID
        +autorId: UUID
        +ocorrencia: Ocorrencia
        +registradaEm: Instant
        +situacao: String
        +origem: String
        +totalRegistrado: Dinheiro
        +formaPagamentoInformada: String?
        +encomendaOrigemId: UUID?
        +versao: Long
        +totalValido(): Dinheiro
    }

class ItemVenda {
        +id: UUID
        +produtoId: UUID
        +nomeSnapshot: String
        +diferenciadorSnapshot: String?
        +quantidade: Quantidade
        +precoUnitarioSnapshot: Dinheiro
        +custoUnitarioSnapshot: Dinheiro?
        +subtotal(): Dinheiro
    }

class Dinheiro {
        <<valueObject>>
        +valor: BigDecimal
    }

class Ocorrencia {
        <<valueObject>>
        +data: LocalDate
        +hora: LocalTime?
        +fuso: ZoneId?
    }

Conta "1" -- "0..*" Venda
Venda "1" *-- "0..*" ItemVenda
ItemVenda "0..*" --> "1" Produto : referencia
Venda ..> Ocorrencia
ItemVenda ..> Dinheiro
